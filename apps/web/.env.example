# Mushi browser app; all VITE_ variables are public in the built bundle.
VITE_API_BASE_URL=http://localhost:3000
# Public Supabase Auth client configuration
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Mushi internal Monitor integration (device UUID is not a secret)
# VITE_MONITOR_DEVICE_ID=YOUR_PAIRED_DEVICE_UUID
# VITE_MONITOR_API_BASE_URL=http://127.0.0.1:3000
# Never put API_ACCESS_TOKEN, database passwords, or service_role keys here.
