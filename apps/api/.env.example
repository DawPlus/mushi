# Mushi API (server-only). Copy to .env locally; never commit secrets.
PORT=3000
WEB_ORIGIN=http://localhost:5173
API_ACCESS_TOKEN=replace-with-a-long-random-server-only-token

# Supabase PostgreSQL (configure only after creating your own project)
# DIRECT_URL=postgresql://...
# DATABASE_URL=postgresql://...

# Supabase Auth owner verification for GET /auth/owner (requires real project setup)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_OWNER_USER_ID=your-auth-user-uuid

# Optional future n8n connection (server-only; do not configure in Vite/Vercel web)
# N8N_BASE_URL=https://your-n8n-instance.example
# N8N_API_KEY=replace-with-private-token

# Monitor heartbeat (server-only, owner and paired Mac device)
# Dedicated Monitor DB login with least privilege; never fall back to admin DATABASE_URL.
# MONITOR_DATABASE_URL=postgresql://mushi_monitor_api.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# MONITOR_OWNER_ID=your-auth-user-uuid
# MONITOR_DEVICE_ID=paired-mac-device-uuid
# MONITOR_DEVICE_TOKEN=your-long-private-device-token
# MONITOR_DEVICE_REVOKED=false  # Set true and restart API to reject this device immediately
# MONITOR_DEVICE_PREVIOUS_TOKEN=old-token-during-rotation-only
# MONITOR_DEVICE_PREVIOUS_TOKEN_VALID_UNTIL=2026-10-10T00:00:00Z

# Optional approved external project remote origins; metadata is never loaded or executed by API
# EXTERNAL_REMOTE_ORIGINS=https://trusted-project.example,http://127.0.0.1:5175

# Bridge MCP (POST /bridge/mcp). Required for authenticated Bridge; never leave unset in production.
# Prefer MUSHI_BRIDGE_TOKEN. ONION_BRIDGE_TOKEN is a compatibility fallback only; unauthenticated mode is not supported.
# Tokens must be at least 32 characters; shorter values are rejected.
# MUSHI_BRIDGE_TOKEN=replace-with-a-long-random-bridge-bearer-token
# ONION_BRIDGE_TOKEN=
# Owner-selectable local workspaces. Labels are public; paths remain server-only.
# MUSHI_BRIDGE_WORKSPACES={"mushi":"/absolute/path/to/mushi"}
